# ---------------------------------------------------------------------------
# 行尾统一
#
# 仓库里一律存 LF，检出到工作区时按下面的规则决定。这样不受各人
# core.autocrlf 设置影响，任何机器 clone 出来都一致，也不会再出现
# "LF will be replaced by CRLF" 之类的提示。
# ---------------------------------------------------------------------------
* text=auto eol=lf

# Windows 批处理必须是 CRLF：cmd.exe 解析 LF-only 的 goto、标签和
# 多行块时会出错，所以这里单独覆盖上面的默认值。
*.cmd text eol=crlf
*.bat text eol=crlf

# PowerShell 脚本按 Windows 惯例用 CRLF
*.ps1 text eol=crlf

# ---------------------------------------------------------------------------
# 二进制：禁止任何行尾转换、合并与文本 diff，避免文件被改坏
# ---------------------------------------------------------------------------
*.ico  binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.zip  binary
*.exe  binary
*.dll  binary

# ---------------------------------------------------------------------------
# 生成物：不计入 GitHub 的语言统计
# ---------------------------------------------------------------------------
package-lock.json linguist-generated=true
